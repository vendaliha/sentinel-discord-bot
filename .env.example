# Copy this file to .env locally. Never commit the real .env file.
# Dashboard server
DASHBOARD_PORT=3000

# Discord OAuth2 application credentials (configure in Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Use a long, random secret for signed sessions when session support is added
SESSION_SECRET=

# Keep the bot token private. Add the real value only to the dashboard host's private environment.
# Required for the dashboard to tell which Administrator servers already have Sentinel.
DISCORD_BOT_TOKEN=

# Optional OAuth bot invite permissions integer. Start at 0 and grant only the permissions Sentinel needs.
# Least-privilege moderation/dashboard permissions (does not grant Administrator).
DISCORD_BOT_PERMISSIONS=1100317060246

# Set this to the absolute path of the existing bot SQLite database when integration is implemented
DATABASE_PATH=
