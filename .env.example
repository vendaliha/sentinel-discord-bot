# Copy this file to .env and fill in your own values. Never commit the real .env.

# --- Bot -------------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot tab). Keep it private.
DISCORD_TOKEN=
# Application (client) ID used to register slash commands.
CLIENT_ID=
# Optional: only this server gets slash commands registered on startup.
GUILD_ID=
# Slash-command registration mode: set to "guild" to register into GUILD_ID only.
COMMAND_REGISTRATION_MODE=
# Optional: alternate guild ID used for command registration.
GUILD_COMMAND_REGISTRATION_ID=
# Optional: path to a different .env file.
BOT_ENV_FILE=

# --- Discord OAuth sign-in for the dashboard -------------------------------
# Required to protect the dashboard API. Use the same Discord application as the bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the redirect URL added in the Discord Developer Portal exactly.
DASHBOARD_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Long random string used to sign session cookies (e.g. openssl rand -hex 32).
SESSION_SECRET=
# Optional session lifetime in milliseconds (default 8 hours).
DASHBOARD_SESSION_TTL_MS=28800000

# --- Storage ---------------------------------------------------------------
# SQLite file shared by the bot and the dashboard API.
DATABASE_PATH=jjsbot.db

# --- Dashboard API (dashboard-api.js) --------------------------------------
# Set to 0 to stop index.js from mounting the API.
DASHBOARD_API_ENABLED=1
DASHBOARD_API_HOST=127.0.0.1
DASHBOARD_API_PORT=4100
# Comma-separated browser origins allowed to call the API.
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
